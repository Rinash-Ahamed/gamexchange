# Firebase Authentication admin access: comma-separated Firebase Auth user UIDs.
# An empty allowlist denies all admin logins. No password-only fallback exists.
FIREBASE_ADMIN_UIDS=replace-with-your-admin-firebase-uid

# Required in production. Generate a unique random value of at least 32 characters.
# Share the same server-only value across instances. Never use NEXT_PUBLIC_.
# Configured Firebase deployments use Firestore for shared rate limits/replay protection.
ENQUIRY_SECRET=

# Cloudflare Turnstile for Contact and Repair (including callback requests).
# Configure both keys together. Both blank leaves the existing anti-abuse checks in place.
# Site key is public; secret key must NEVER use NEXT_PUBLIC_.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Firebase web app config (Project settings > General > Your apps > Web app).
# Public client identifiers, never put a service-account private key here.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-private-key\n-----END PRIVATE KEY-----\n"

# Leave empty to use the default Firestore database.
FIREBASE_DATABASE_ID=

# Firebase Storage bucket name for admin banner uploads, without gs://.
# Copy the exact name from Firebase Console > Storage.
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app

# Set true only on Google hosting with Application Default Credentials configured.
FIREBASE_USE_APPLICATION_DEFAULT_CREDENTIALS=false

# Razorpay TEST mode only. Live keys are deliberately rejected by this implementation.
# Server-only: never prefix the secret or webhook secret with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set the same independent secret in the Razorpay TEST webhook settings.
RAZORPAY_WEBHOOK_SECRET=

# Backend Gmail order notifications. Current checkout sends clearly labelled TEST emails.
# Server-only. Use an App Password, never your normal Google password.
# SMTP_USER is the sending account; it can differ from the notification recipient.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Paste the 16-character App Password without display spaces. Never use NEXT_PUBLIC_.
SMTP_PASS=
MAIL_FROM_NAME=GameXchange
NOTIFICATION_EMAIL=finance.gxc@gmail.com
# Protects GET /api/internal/order-emails. Configure an external scheduler every 30 minutes (*/30 * * * *).
# Independent random secret, at least 32 characters. Never use NEXT_PUBLIC_.
# Also protects /api/internal/checkout-reservations. Call that separate worker
# every minute to reconcile expired ten-minute TEST stock holds. See .agent/RAZORPAY_SETUP.md.
CRON_SECRET=
# Optional allowlisted backend request timing logs. Never includes customer data or headers.
PERFORMANCE_LOGGING=false
