# Firebase Authentication admin access: comma-separated Firebase Auth user UIDs.
# An empty allowlist denies all admin logins. No password-only fallback exists.
FIREBASE_ADMIN_UIDS=replace-with-your-admin-firebase-uid

# Firebase web app config (Project settings > General > Your apps > Web app).
# Public client identifiers, never put a service-account private key here.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-private-key\n-----END PRIVATE KEY-----\n"

# Leave empty to use the default Firestore database.
FIREBASE_DATABASE_ID=

# Firebase Storage bucket name for admin banner uploads, without gs://.
# Copy the exact name from Firebase Console > Storage.
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app

# Set true only on Google hosting with Application Default Credentials configured.
FIREBASE_USE_APPLICATION_DEFAULT_CREDENTIALS=false

# Razorpay TEST mode only. Live keys are deliberately rejected by this implementation.
# Server-only: never prefix the secret or webhook secret with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set the same independent secret in the Razorpay TEST webhook settings.
RAZORPAY_WEBHOOK_SECRET=
